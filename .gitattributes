# Keep benchmark JSON bytes and SHA-256 checks identical on Windows and Linux.
* text=auto eol=lf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.pdf binary
*.docx binary
# Preserve generated receipts, CSV and ZIP member bytes exactly across checkouts.
frontend/public/research/multicity-terrain/** -text whitespace=cr-at-eol
