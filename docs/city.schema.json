        "floor_height": {
          "default": 3.2,
          "maximum": 4.5,
          "minimum": 2.5,
          "title": "Floor Height",
          "type": "number"
        },
        "longitude": {
          "default": -2.5879,
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "latitude": {
          "default": 51.4545,
          "maximum": 85,
          "minimum": -85,
          "title": "Latitude",
          "type": "number"
        },
        "altitude": {
          "default": 0,
          "maximum": 9000,
          "minimum": -500,
          "title": "Altitude",
          "type": "number"
        },
        "heading": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Heading",
          "type": "number"
        }
