{
  "$defs": {
    "BuildingDocument": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "gugis-studio",
          "title": "Format",
          "type": "string"
        },
        "version": {
          "enum": [
            "1.0",
            "1.1",
            "1.2"
          ],
          "title": "Version",
          "type": "string"
        },
        "coordinate_system": {
          "const": "ENU_METERS_WGS84",
          "title": "Coordinate System",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/BuildingParameters"
        },
        "templates": {
          "maxProperties": 1024,
          "minProperties": 1,
          "patternProperties": {
            "^[a-zA-Z0-9_-]{1,64}$": {
              "$ref": "#/$defs/SolidTemplate"
            }
          },
          "title": "Templates",
          "type": "object"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/SemanticNode"
          },
          "maxItems": 12000,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "overview": {
          "anyOf": [
            {
              "maxProperties": 8,
              "patternProperties": {
                "^[a-zA-Z0-9_-]{1,64}$": {
                  "$ref": "#/$defs/SolidTemplate"
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overview"
        }
      },
      "required": [
        "format",
        "version",
        "coordinate_system",
        "parameters",
        "templates",
        "nodes"
      ],
      "title": "BuildingDocument",
      "type": "object"
    },
    "BuildingParameters": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "语义住宅示范楼",
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "tower",
          "enum": [
            "tower",
            "villa",
            "georgian",
            "victorian",
            "wills",
            "cabot",
            "cathedral",
            "tudor",
            "warehouse",
            "chapel",
            "civic",
            "footprint",
            "urban"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scale": {
          "default": 1,
          "maximum": 2,
          "minimum": 0.5,
          "title": "Scale",
          "type": "number"
        },
        "floors": {
          "default": 12,
          "maximum": 30,
          "minimum": 1,
          "title": "Floors",
          "type": "integer"
        },
        "units": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Units",
          "type": "integer"
